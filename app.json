{
  "expo": {
    "name": "Ritmo",
    "slug": "ritmo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "ritmo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/branding/icon.png",
      "bundleIdentifier": "com.jmblack27.ritmo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#173C2B",
        "foregroundImage": "./assets/branding/adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jmblack27.ritmo",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173C2B",
          "image": "./assets/branding/splash.png",
          "imageWidth": 180
        }
      ],
      "expo-sqlite",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfa97370-2978-4d84-938c-bf4b950f49d8"
      }
    },
    "owner": "jmblack27"
  }
}
